{
    "name": "dartforge",
    "displayName": "DartForge",
    "description": "Dart language support through the DartForge server (incremental diagnostics, low memory use).",
    "version": "0.1.0",
    "publisher": "dartforge",
    "license": "MIT",
    "repository": {
        "url": "https://github.com/anomalyco/opencode",
        "type": "git"
    },
    "engines": {
        "vscode": "^1.93.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "activationEvents": [
        "onLanguage:dart"
    ],
    "main": "./out/extension",
    "contributes": {
        "configuration": {
            "title": "DartForge",
            "properties": {
                "dartforge.serverPath": {
                    "type": [
                        "null",
                        "string"
                    ],
                    "scope": "machine-overridable",
                    "default": null,
                    "markdownDescription": "Path of the `dartforge-lsp` binary. When empty, the extension looks for `dartforge-lsp` on the `PATH`."
                },
                "dartforge.trace.server": {
                    "type": "string",
                    "scope": "window",
                    "enum": [
                        "off",
                        "messages",
                        "verbose"
                    ],
                    "default": "off",
                    "description": "Traces the messages between the client and the server (verbose; for debugging only)."
                }
            }
        }
    },
    "scripts": {
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./"
    },
    "dependencies": {
        "vscode-languageclient": "^9.0.1"
    },
    "devDependencies": {
        "@types/node": "~22.13.4",
        "@types/vscode": "~1.93.0",
        "typescript": "^5.6.3"
    }
}
