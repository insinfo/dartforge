import 'banco.dart';

CREATE TABLE etiquetas (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  nome TEXT NOT NULL UNIQUE,
  cor INTEGER NOT NULL DEFAULT 0,
  estado ENUM(Situacao) NOT NULL
);

CREATE INDEX etiquetas_por_nome ON etiquetas (nome);

contasComSaldo: SELECT c.nome, co.saldo FROM clientes c
  INNER JOIN contas co ON co.cliente = c.id
  WHERE co.saldo >= :minimo AND $filtro
  ORDER BY c.nome;

contarEtiquetas: SELECT COUNT(*) FROM etiquetas;
