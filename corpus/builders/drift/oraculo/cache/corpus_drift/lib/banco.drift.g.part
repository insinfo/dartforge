mixin _$ContasDaoMixin on DatabaseAccessor<Banco> {
  $ClientesTable get clientes => attachedDatabase.clientes;
  $ContasTable get contas => attachedDatabase.contas;
}

class Etiquetas extends Table with TableInfo<Etiquetas, Etiqueta> {
