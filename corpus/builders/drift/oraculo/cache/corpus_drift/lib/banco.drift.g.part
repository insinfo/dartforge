    final map = <String, Expression>{};
    map['id'] = Variable<int>(id);
    map['cliente'] = Variable<int>(cliente);
    map['saldo'] = Variable<double>(saldo);
    {
      map['situacao'] =
          Variable<int>($ContasTable.$convertersituacao.toSql(situacao));
    }
    return map;
