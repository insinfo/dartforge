    };
  }

  Conta copyWith({int? id, int? cliente, double? saldo, Situacao? situacao}) =>
      Conta(
        id: id ?? this.id,
        cliente: cliente ?? this.cliente,
        saldo: saldo ?? this.saldo,
        situacao: situacao ?? this.situacao,
