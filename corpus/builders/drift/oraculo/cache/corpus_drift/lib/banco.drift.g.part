      const EnumIndexConverter<Situacao>(Situacao.values);
  @override
  bool get dontWriteConstraints => true;
}

class Etiqueta extends DataClass implements Insertable<Etiqueta> {
  final int id;
  final String nome;
  final int cor;
  final Situacao estado;
  const Etiqueta(
      {required this.id,
      required this.nome,
      required this.cor,
      required this.estado});
  @override
  Map<String, Expression> toColumns(bool nullToAbsent) {
    final map = <String, Expression>{};
    map['id'] = Variable<int>(id);
    map['nome'] = Variable<String>(nome);
    map['cor'] = Variable<int>(cor);
    {
      map['estado'] = Variable<int>(Etiquetas.$converterestado.toSql(estado));
    }
    return map;
  }

  EtiquetasCompanion toCompanion(bool nullToAbsent) {
    return EtiquetasCompanion(
      id: Value(id),
      nome: Value(nome),
      cor: Value(cor),
      estado: Value(estado),
    );
  }

  factory Etiqueta.fromJson(Map<String, dynamic> json,
      {ValueSerializer? serializer}) {
    serializer ??= driftRuntimeOptions.defaultSerializer;
    return Etiqueta(
      id: serializer.fromJson<int>(json['id']),
      nome: serializer.fromJson<String>(json['nome']),
      cor: serializer.fromJson<int>(json['cor']),
      estado: Etiquetas.$converterestado
          .fromJson(serializer.fromJson<int>(json['estado'])),
    );
  }
  @override
  Map<String, dynamic> toJson({ValueSerializer? serializer}) {
    serializer ??= driftRuntimeOptions.defaultSerializer;
    return <String, dynamic>{
      'id': serializer.toJson<int>(id),
      'nome': serializer.toJson<String>(nome),
      'cor': serializer.toJson<int>(cor),
      'estado':
          serializer.toJson<int>(Etiquetas.$converterestado.toJson(estado)),
    };
  }

  Etiqueta copyWith({int? id, String? nome, int? cor, Situacao? estado}) =>
      Etiqueta(
        id: id ?? this.id,
        nome: nome ?? this.nome,
        cor: cor ?? this.cor,
        estado: estado ?? this.estado,
      );
  Etiqueta copyWithCompanion(EtiquetasCompanion data) {
    return Etiqueta(
      id: data.id.present ? data.id.value : this.id,
      nome: data.nome.present ? data.nome.value : this.nome,
      cor: data.cor.present ? data.cor.value : this.cor,
      estado: data.estado.present ? data.estado.value : this.estado,
    );
  }

  @override
  String toString() {
    return (StringBuffer('Etiqueta(')
          ..write('id: $id, ')
          ..write('nome: $nome, ')
          ..write('cor: $cor, ')
          ..write('estado: $estado')
          ..write(')'))
        .toString();
  }

  @override
  int get hashCode => Object.hash(id, nome, cor, estado);
  @override
  bool operator ==(Object other) =>
      identical(this, other) ||
      (other is Etiqueta &&
          other.id == this.id &&
          other.nome == this.nome &&
          other.cor == this.cor &&
          other.estado == this.estado);
}

class EtiquetasCompanion extends UpdateCompanion<Etiqueta> {
  final Value<int> id;
  final Value<String> nome;
  final Value<int> cor;
  final Value<Situacao> estado;
  const EtiquetasCompanion({
    this.id = const Value.absent(),
    this.nome = const Value.absent(),
    this.cor = const Value.absent(),
    this.estado = const Value.absent(),
  });
  EtiquetasCompanion.insert({
    this.id = const Value.absent(),
    required String nome,
    this.cor = const Value.absent(),
    required Situacao estado,
  })  : nome = Value(nome),
        estado = Value(estado);
  static Insertable<Etiqueta> custom({
    Expression<int>? id,
    Expression<String>? nome,
    Expression<int>? cor,
    Expression<int>? estado,
  }) {
    return RawValuesInsertable({
      if (id != null) 'id': id,
      if (nome != null) 'nome': nome,
      if (cor != null) 'cor': cor,
      if (estado != null) 'estado': estado,
    });
  }

  EtiquetasCompanion copyWith(
      {Value<int>? id,
      Value<String>? nome,
      Value<int>? cor,
      Value<Situacao>? estado}) {
    return EtiquetasCompanion(
      id: id ?? this.id,
      nome: nome ?? this.nome,
      cor: cor ?? this.cor,
      estado: estado ?? this.estado,
    );
  }

  @override
  Map<String, Expression> toColumns(bool nullToAbsent) {
    final map = <String, Expression>{};
    if (id.present) {
      map['id'] = Variable<int>(id.value);
    }
    if (nome.present) {
      map['nome'] = Variable<String>(nome.value);
    }
    if (cor.present) {
      map['cor'] = Variable<int>(cor.value);
    }
    if (estado.present) {
      map['estado'] =
          Variable<int>(Etiquetas.$converterestado.toSql(estado.value));
    }
    return map;
  }

  @override
  String toString() {
    return (StringBuffer('EtiquetasCompanion(')
          ..write('id: $id, ')
          ..write('nome: $nome, ')
          ..write('cor: $cor, ')
          ..write('estado: $estado')
          ..write(')'))
        .toString();
  }
}

