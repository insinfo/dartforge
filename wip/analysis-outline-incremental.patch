+thread_local! {
+    /// The files whose declaration bodies the loads of this thread read
+    /// ([`with_bodies_only_for`]), by [`crate::generated::key`].
+    static BODIES_ONLY_FOR: std::cell::RefCell<Option<std::sync::Arc<std::collections::HashSet<PathBuf>>>> = const { std::cell::RefCell::new(None) };
+}
+
+/// Runs `f` with the loads of this thread reading every file outside `files`
+/// (keys from [`crate::generated::key`]) without the declarations' block
+/// bodies ([`dartforge_frontend::parser::parse_lexed_outline`]); the SDK comes
+/// from its cache as usual. It is the load of an analysis that reports only on
+/// `files`: the bodies of the other files are never inferred, and they were
+/// most of the program's tree (the dependencies). Loads with a unit cache (a
+/// resident session) are not affected.
+pub fn with_bodies_only_for<R>(files: std::sync::Arc<std::collections::HashSet<PathBuf>>, f: impl FnOnce() -> R) -> R {
+    struct Restore(Option<std::sync::Arc<std::collections::HashSet<PathBuf>>>);
+    impl Drop for Restore {
+        fn drop(&mut self) {
+            let previous = self.0.take();
+            BODIES_ONLY_FOR.with(|b| *b.borrow_mut() = previous);
+        }
+    }
+    let previous = BODIES_ONLY_FOR.with(|b| b.borrow_mut().replace(files));
+    let _restore = Restore(previous);
+    f()
+}
+
+/// The file is read without bodies ([`with_bodies_only_for`]).
+fn without_bodies(path: &Path) -> bool {
+    BODIES_ONLY_FOR.with(|b| b.borrow().as_ref().is_some_and(|files| !files.contains(&crate::generated::key(path))))
+}
