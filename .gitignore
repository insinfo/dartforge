/target/
# qualquer target/ aninhado: cache do SDK gravado relativo ao crate por testes, e corpus/js/*/target
**/target/
/dist/
/references/
/work/
/.vscode/
*.log
.env
.env.*
!.env.example

# Destinos alternativos do Cargo (agentes, medições A/B, corpus) e a saída
# de scripts/ab-backend.sh. Temporários ficam em target/tmp-* (ESTADO.md §3.1).
/target-*

# Extensões e ferramentas de desenvolvimento
editors/vscode/node_modules/
editors/vscode/out/
editors/vscode/package-lock.json

# SDK compilado pelo DDC: gerado por scripts/gerar-dart-sdk.ps1
runtime/ddc/dart_sdk.js
runtime/ddc/dart_sdk.js.map
# o dart_sdk.js do SDK de oráculo 3.13 (crates/diferencial), por versão
runtime/ddc/*/

# worktrees de subagentes
.claude/worktrees/

# Corpus do ngdart: o oráculo commitado é `corpus/ngdart/oraculo/`; o que o
# build_runner deixa (81 MB, 2.305 artefatos) se regenera com
# scripts/corpus-ngdart.ps1.
/corpus/ngdart/.dart_tool/
/corpus/ngdart/.packages
