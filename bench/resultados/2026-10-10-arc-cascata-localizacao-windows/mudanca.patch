+    #[test]
+    fn cascata_limitada_preserva_raiz_multiplicidade_e_geracao_em_pagina_reformatada() {
+        use crate::layout::DESLOCAMENTO_DO_HANDLE;
+        for paginada in [false, true] {
+            let primeiro = (1u64 << 32) + 1024;
+            let h1 = primeiro as Ref + DESLOCAMENTO_DO_HANDLE;
+            let h2 = h1 + 24;
+            let h3 = 2; // Reserva por hash, mesmo quando os outros usam página.
+            let geometria = paginada.then_some(Geometria { primeiro, tamanho: 24, blocos: 4 });
