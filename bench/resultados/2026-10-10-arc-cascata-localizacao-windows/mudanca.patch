+            assert_eq!(a.meta(h3).unwrap().rc, 0);
+            assert_eq!(a.drenar_zeros(&mut g, 1, &|_| false), Ok(1));
+            assert_eq!(a.tomar_mortos(), vec![h2, h3]);
+            assert_eq!(a.registrados(), 0);
