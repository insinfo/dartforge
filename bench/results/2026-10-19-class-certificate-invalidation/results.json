[
  {
    "name": "fmt",
    "command": [
      "cargo",
      "fmt",
      "--all",
      "--",
      "--check"
    ],
    "exit": 1
  },
  {
    "name": "clippy",
    "command": [
      "cargo",
      "clippy",
      "--locked",
      "--workspace",
      "--all-targets",
      "--",
      "-D",
      "warnings"
    ],
    "exit": 0
  },
  {
    "name": "doc",
    "command": [
      "cargo",
      "doc",
      "--locked",
      "--workspace",
      "--no-deps",
      "--document-private-items"
    ],
    "exit": 0
  }
]
