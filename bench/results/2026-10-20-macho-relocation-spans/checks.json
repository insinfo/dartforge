[
  {
    "name": "clippy",
    "command": [
      "cargo",
      "clippy",
      "--locked",
      "--workspace",
      "--all-targets",
      "--",
      "-D",
      "warnings"
    ],
    "exit": 0
  },
  {
    "name": "feature-clippy",
    "command": [
      "cargo",
      "clippy",
      "--locked",
      "-p",
      "dartforge-emit-native",
      "--features",
      "embedded-llvm",
      "--all-targets",
      "--",
      "-D",
      "warnings"
    ],
    "exit": 0
  },
  {
    "name": "doc",
    "command": [
      "cargo",
      "doc",
      "--locked",
      "--workspace",
      "--no-deps",
      "--document-private-items"
    ],
    "exit": 0
  },
  {
    "name": "native-lib",
    "command": [
      "cargo",
      "test",
      "--locked",
      "-p",
      "dartforge-emit-native",
      "--lib",
      "--",
      "--include-ignored"
    ],
    "exit": 0
  },
  {
    "name": "linked-directed",
    "command": [
      "cargo",
      "test",
      "--locked",
      "-p",
      "dartforge-emit-native",
      "--lib",
      "linked_images",
      "--",
      "--include-ignored",
      "--nocapture"
    ],
    "exit": 0
  },
  {
    "name": "example",
    "command": [
      "cargo",
      "run",
      "--locked",
      "-p",
      "dartforge-emit-native",
      "--example",
      "inspect_linked_images",
      "--",
      "target/desktop-matrix/macos-arm64/explorer",
      "target/desktop-matrix/cross-linux-arm64/explorer",
      "target/desktop-matrix/cross-windows-x64/explorer.exe"
    ],
    "exit": 0
  }
]
