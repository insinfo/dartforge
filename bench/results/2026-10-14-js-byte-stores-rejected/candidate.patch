@@ -0,0 +1,83 @@
+//! Canonical SDK byte stores retain ordinary Dart output with checked fallback.
+
+use std::path::Path;
+use std::process::Command;
+
+#[test]
+#[ignore = "requires Dart 3.6.2 and Node on PATH"]
+fn byte_encoders_match_vm_and_o2_with_guard_enabled_or_disabled() {
+    let source =
+        Path::new(env!("CARGO_MANIFEST_DIR")).join("../emit_js/tests/programs/typed_stores.dart");
+    let directory =
+        std::env::temp_dir().join(format!("dartforge-byte-stores-{}", std::process::id()));
+    std::fs::create_dir_all(&directory).unwrap();
+    let sdk = Command::new("dart").args(["--version"]).output().unwrap();
+    assert!(sdk.status.success());
+    let vm = Command::new("dart")
+        .arg("run")
+        .arg(&source)
+        .output()
+        .unwrap();
+    assert!(
+        vm.status.success(),
+        "{}",
+        String::from_utf8_lossy(&vm.stderr)
+    );
+    let expected = String::from_utf8(vm.stdout).unwrap().replace("\r\n", "\n");
+    for profile in ["O2", "raw.off", "raw.on", "min.off", "min.on"] {
+        let output = directory.join(format!("{profile}.js"));
+        let mut command = if profile == "O2" {
+            let mut c = Command::new("dart");
+            c.args(["compile", "js", "-O2"]);
+            c
+        } else {
+            let mut c = Command::new(env!("CARGO_BIN_EXE_dartforge-jsprod"));
+            if profile.starts_with("raw") {
+                c.arg("--no-minify");
+            }
+            c.env(
+                "DARTFORGE_JSPROD_BYTE_STORES",
+                if profile.ends_with("on") { "1" } else { "0" },
+            );
+            c
+        };
+        let result = command
+            .arg(&source)
+            .arg("-o")
+            .arg(&output)
+            .output()
+            .unwrap();
+        assert!(
+            result.status.success(),
+            "{profile}: {}{}",
+            String::from_utf8_lossy(&result.stdout),
+            String::from_utf8_lossy(&result.stderr)
+        );
+        if profile.starts_with("raw") {
+            assert_eq!(
+                std::fs::read_to_string(&output)
+                    .unwrap()
+                    .contains("function t$ByteStore("),
+                profile.ends_with("on")
+            );
+        }
+        let result = Command::new("node")
+            .args(["-e", "globalThis.self=globalThis;require(process.argv[1])"])
+            .arg(&output)
+            .output()
+            .unwrap();
+        assert!(
+            result.status.success() && result.stderr.is_empty(),
+            "{profile}: {}",
+            String::from_utf8_lossy(&result.stderr)
+        );
+        assert_eq!(
+            String::from_utf8(result.stdout)
+                .unwrap()
+                .replace("\r\n", "\n"),
+            expected,
+            "{profile}"
+        );
+    }
+    std::fs::remove_dir_all(directory).unwrap();
+}
