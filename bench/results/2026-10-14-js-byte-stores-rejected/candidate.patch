+//! Guard canonical SDK byte stores with their original checked dispatch.
+//!
+//! A nominal typed-list type is only an eligibility hint. The runtime must
+//! certify the physical view, current operator/dependencies and fixed storage.
+//! A failed guard invokes the original selector after all arguments evaluated.
+
+use crate::{body::FnEmitter, ctx::Ctx, module::ModState, ty::Ty};
+use dartforge_elements::model::{
+    ClassId, Element, FunctionElementId, FunctionKind, FunctionRef, LibraryId,
+};
+use dartforge_frontend::ast;
+
+struct Plan {
+    library: LibraryId,
+    array: ClassId,
+    setter: ClassId,
+}
+
+fn compact(text: &str) -> String {
+    let mut out = String::new();
+    let mut quote = None;
+    let mut escaped = false;
+    for ch in text.chars() {
+        if let Some(end) = quote {
+            out.push(ch);
+            if escaped {
+                escaped = false;
+            } else if ch == '\\' {
+                escaped = true;
+            } else if ch == end {
+                quote = None;
+            }
+        } else if ch == '\'' || ch == '"' {
+            quote = Some(ch);
+            out.push(ch);
+        } else if !ch.is_whitespace() {
+            out.push(ch);
+        }
+    }
+    out
+}
+
+fn body_matches(ctx: &Ctx, fid: FunctionElementId, expected: &str, parameters: &[&str]) -> bool {
+    let f = ctx.program.function(fid);
+    if f.patched_by.is_some() || f.external {
+        return false;
+    }
+    let FunctionRef::Function { unit, function } = f.node else {
+        return false;
+    };
+    let u = ctx.program.unit(unit);
+    let a = u.ast.function(function);
+    if a.modifier != ast::AsyncModifier::None || !a.type_params.is_empty() {
+        return false;
+    }
+    let params = a.parameters.as_deref().unwrap_or(&[]);
+    if params.len() != parameters.len()
+        || !params.iter().zip(parameters).all(|(p, n)| {
+            p.kind == ast::ParameterKind::Required
+                && p.name.is_some_and(|name| ctx.name(name.sym) == *n)
+        })
+    {
+        return false;
+    }
+    let span = match a.body {
+        ast::FunctionBody::Block(s) => u.ast.stmt(s).span,
+        ast::FunctionBody::Expression(e) => u.ast.expr(e).span,
+        _ => return false,
+    };
+    compact(&u.source[span.start..span.end]) == compact(expected)
+}
+
+fn plan(ctx: &Ctx) -> Option<Plan> {
+    let (li, lib) = ctx
+        .program
+        .libraries
+        .iter()
+        .enumerate()
+        .find(|(_, l)| l.uri == "dart:_native_typed_data")?;
+    let class = |name| match lib.declared.get(&ctx.sym(name)?)?.getter? {
+        Element::Class(c) => Some(c),
+        _ => None,
+    };
+    let array = class("NativeUint8List")?;
+    let setter = class("NativeTypedArrayOfInt")?;
+    if !ctx.program.class(array).modifiers.final_ || !ctx.program.class(setter).modifiers.final_ {
+        return None;
+    }
+    let method = |c: ClassId, name| {
+        ctx.program
+            .class(c)
+            .instance_members
+            .get(&ctx.sym(name)?)
+            .copied()
+    };
+    let set = method(setter, "[]=")?;
+    let length = method(array, "length")?;
+    let library = LibraryId(li as u32);
+    if ctx.program.function(set).kind != FunctionKind::Operator
+        || ctx.program.function(set).class != Some(setter)
+        || ctx.program.function(set).library != library
+        || ctx.program.function(set).static_
+        || ctx.program.function(length).kind != FunctionKind::Getter
+        || ctx.program.function(length).class != Some(array)
+        || ctx.program.function(length).library != library
+        || ctx.program.function(length).static_
+    {
+        return None;
+    }
+    if !body_matches(
+        ctx,
+        set,
+        "{_checkValidIndex(index, this, this.length); JS('void', '#[#] = #', this, index, value);}",
+        &["index", "value"],
+    ) || !body_matches(ctx, length, "JS<int>('!', '#.length', this)", &[])
+    {
+        return None;
+    }
+    let function = |name| match lib.declared.get(&ctx.sym(name)?)?.getter? {
+        Element::Function(f) => Some(f),
+        _ => None,
+    };
+    let check = function("_checkValidIndex")?;
+    let invalid = function("_isInvalidArrayIndex")?;
+    if [check, invalid].iter().any(|fid| {
+        let f = ctx.program.function(*fid);
+        f.library != library || f.class.is_some() || f.extension.is_some()
+    }) {
+        return None;
+    }
+    let Ty::Fn {
+        pos: gp,
+        opt: go,
+        named: gn,
+        ret: gr,
+        ..
+    } = ctx.fn_ty(length)
+    else {
+        return None;
+    };
+    let Ty::Fn {
+        pos: cp,
+        opt: co,
+        named: cn,
+        ret: cr,
+        ..
+    } = ctx.fn_ty(check)
+    else {
+        return None;
+    };
+    let Ty::Fn {
+        pos: ip,
+        opt: io,
+        named: inn,
+        ret: ir,
+        ..
+    } = ctx.fn_ty(invalid)
+    else {
+        return None;
+    };
+    if !gp.is_empty()
+        || !go.is_empty()
+        || !gn.is_empty()
+        || !ctx.is_int(&gr)
+        || gr.is_nullable()
+        || cp.len() != 3
+        || !ctx.is_int(&cp[0])
+        || cp[0].is_nullable()
+        || cp[1].class() != ctx.list_
+        || cp[1].is_nullable()
+        || !ctx.is_int(&cp[2])
+        || cp[2].is_nullable()
+        || !co.is_empty()
+        || !cn.is_empty()
+        || !matches!(*cr, Ty::Void)
+        || ip.len() != 1
+        || !ctx.is_int(&ip[0])
+        || ip[0].is_nullable()
+        || !io.is_empty()
+        || !inn.is_empty()
+        || !ctx.is_bool(&ir)
+        || ir.is_nullable()
+    {
+        return None;
+    }
+    if !body_matches(
+        ctx,
+        check,
+        "{if (_isInvalidArrayIndex(index) || JS<int>('!', '#', index) >= length) {throw diagnoseIndexError(list, index);}}",
+        &["index", "list", "length"],
+    ) || !body_matches(
+        ctx,
+        invalid,
+        "{return (JS<bool>('!', '(# >>> 0 !== #)', index, index));}",
+        &["index"],
+    ) {
+        return None;
+    }
+    let Ty::Fn {
+        pos,
+        opt,
+        named,
+        ret,
+        ..
+    } = ctx.fn_ty(set)
+    else {
+        return None;
+    };
+    if pos.len() != 2
+        || !pos.iter().all(|t| ctx.is_int(t) && !t.is_nullable())
+        || !opt.is_empty()
+        || !named.is_empty()
+        || !matches!(*ret, Ty::Void)
+    {
+        return None;
+    }
+    Some(Plan {
+        library: LibraryId(li as u32),
+        array,
+        setter,
+    })
+}
+
+impl FnEmitter<'_, '_> {
+    pub(crate) fn guarded_sdk_byte_store(&self, ty: &Ty, access: &str) -> bool {
+        if !self.ctx.production()
+            || !self.ctx.libs[self.lib.0 as usize].is_sdk
+            || std::env::var("DARTFORGE_JSPROD_BYTE_STORES").is_ok_and(|v| v == "0")
+        {
+            return false;
+        }
+        let Ty::Iface {
+            class,
+            nullable: false,
+            ..
+        } = ty
+        else {
+            return false;
+        };
+        let c = self.ctx.program.class(*class);
+        if !matches!(
+            (
+                self.ctx.program.library(c.library).uri.as_str(),
+                self.ctx.class_name(*class)
+            ),
+            ("dart:typed_data", "Uint8List") | ("dart:_native_typed_data", "NativeUint8List")
+        ) || plan(self.ctx).is_none()
+        {
+            return false;
+        }
+        if access != format!("[{}]", self.m.dartx("_set")) {
+            return false;
+        }
+        self.m.byte_stores.set(true);
+        true
+    }
+}
+
+/// Definitions are hoisted so an eager SDK initializer keeps the original
+/// dispatch until the post-class capture has completed.
+pub(crate) fn emit(ctx: &Ctx, m: &ModState, output: &mut String) {
+    if !m.byte_stores.get() {
+        return;
+    }
+    let Some(p) = plan(ctx) else { return };
+    let namespace = &ctx.libs[p.library.0 as usize].js_var;
+    let array = format!("{namespace}.{}", ctx.class_name(p.array));
+    let setter = format!("{namespace}.{}", ctx.class_name(p.setter));
+    let slot = m.dartx("_set");
+    let length = m.dartx("length");
+    output.push_str(RUNTIME);
+    output.push_str(&format!("t$ByteStoreState = t$ByteStoreCapture({namespace}, {array}.prototype, {setter}.prototype._set, {slot}, {length});\n"));
+}
+
+const RUNTIME: &str = r#"
+var t$ByteStoreState;
+function t$ByteStoreCapture(lib, cls, expected, slot, length) {
+  try {
+    const desc = Object.getOwnPropertyDescriptor, proto = Object.getPrototypeOf, apply = Reflect.apply;
+    const view = ArrayBuffer.isView, physical = Uint8Array.prototype, typed = proto(physical);
+    const own = Object.prototype.hasOwnProperty;
+    const read = (object, key, field) => { const d = desc(object, key); return d && apply(own, d, [field]) ? d[field] : undefined; }; 
+    const setter = read(physical, slot, 'value'), len = read(physical, length, 'get'), canonical = read(cls, length, 'get');
+    if (typeof setter !== 'function' || setter !== expected || typeof len !== 'function' || len !== canonical) return null;
+    return { desc, read, proto, apply, view, physical, typed, slot, length, setter, getter: len,
+      buffer: read(typed, 'buffer', 'get'), size: read(typed, 'length', 'get'),
+      bytes: read(ArrayBuffer.prototype, 'byteLength', 'get'),
+      resize: read(ArrayBuffer.prototype, 'resizable', 'get'),
+      lib, check: read(lib, '_checkValidIndex', 'value'), invalid: read(lib, '_isInvalidArrayIndex', 'value') };
+  } catch (_) { return null; }
+}
+function t$ByteStore(array, index, value, slot) {
+  const c = t$ByteStoreState;
+  if (c && slot === c.slot && typeof index === 'number' && (index >>> 0) === index &&
+      typeof value === 'number' && value % 1 === 0) {
+    try {
+      if (c.view(array) && c.proto(array) === c.physical &&
+          c.proto(c.physical) === c.typed && !c.desc(c.physical, 'length') && c.read(c.typed, 'length', 'get') === c.size &&
+          c.read(c.physical, slot, 'value') === c.setter && c.read(c.physical, c.length, 'get') === c.getter &&
+          c.read(c.lib, '_checkValidIndex', 'value') === c.check && c.read(c.lib, '_isInvalidArrayIndex', 'value') === c.invalid &&
+          !c.desc(array, slot) && !c.desc(array, c.length) && !c.desc(array, 'length') &&
+          !c.desc(array, 'buffer') && !c.desc(array, '$flags')) {
+        const buffer = c.apply(c.buffer, array, []);
+        c.apply(c.bytes, buffer, []);
+        if ((!c.resize || !c.apply(c.resize, buffer, [])) && index < c.apply(c.size, array, [])) {
+          array[index] = value;
+          return value;
+        }
+      }
+    } catch (_) { /* Intrinsic brand/storage refusal keeps original dispatch. */ }
+  }
+  array[slot](index, value);
+  return value;
+}
