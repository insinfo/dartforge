+import 'dart:convert';
+import 'dart:typed_data';
+
+int checksum(List<int> bytes) {
+  var result = bytes.length;
+  for (final byte in bytes) result = (result * 31 + byte) & 0x3fffffff;
+  return result;
+}
+
+void main() {
+  final codec = json.fuse(utf8);
+  final documents = <Object?>[
+    {'name': 'plain', 'items': [1, 2, 3], 'enabled': true, 'nothing': null},
+    {'escaped': 'quotes " and \\ slash\n\t\u0001', 'unicode': 'ação 中文 😀𝄞'},
+    [for (var i = 0; i < 300; i++) {'id': i, 'text': 'value $i 😀'}],
+  ];
+  for (final document in documents) {
+    final bytes = codec.encode(document);
+    print('${bytes.length} ${checksum(bytes)}');
+    print(jsonEncode(codec.decode(bytes)) == jsonEncode(document));
+  }
+  for (final text in ['ASCII', 'ação 中文 😀𝄞', 'x' * 6000]) {
+    final bytes = utf8.encode(text);
+    print('${bytes.length} ${checksum(bytes)} ${utf8.decode(bytes) == text}');
+  }
+  final data = Uint8List.fromList([-1, 0, 255, 256, 511]);
+  print(data);
+  try {
+    data.asUnmodifiableView()[0] = 99;
+    print('readonly accepted');
+  } catch (error) {
+    print(error is UnsupportedError);
+  }
+  print(data);
+}
