+fn fixture() -> Function {
+    Function {
+        symbol: "checked".into(),
+        name: "checked".into(),
+        params: vec![(ValueId(0), "value".into(), Type::Ref)],
+        return_ty: Type::Ref,
+        debug_info: None,
+        blocks: vec![
+            BasicBlock {
+                id: BlockId(0),
+                instructions: vec![
+                    (
+                        ValueId(1),
+                        Instruction::Unbox {
+                            op: Operand::Val(ValueId(0)),
+                            to: Type::F64,
+                        },
+                        Type::F64,
+                    ),
+                    (
+                        ValueId(2),
+                        Instruction::CallRuntime {
+                            name: "dartforge_exception_pending".into(),
+                            args: vec![],
+                            ret_ty: Type::I8,
+                        },
+                        Type::I8,
+                    ),
+                    (
+                        ValueId(3),
+                        Instruction::ICmp(
+                            ICmpOp::Ne,
+                            Operand::Val(ValueId(2)),
+                            Operand::Constant(Constant::Int(0)),
+                        ),
+                        Type::I1,
+                    ),
+                ],
+                terminator: Terminator::CondBranch {
+                    cond: Operand::Val(ValueId(3)),
+                    then_block: BlockId(2),
+                    else_block: BlockId(1),
+                },
+            },
+            BasicBlock {
+                id: BlockId(1),
+                instructions: vec![(
+                    ValueId(4),
+                    Instruction::Box {
+                        op: Operand::Val(ValueId(1)),
+                        from: Type::F64,
+                    },
+                    Type::Ref,
+                )],
+                terminator: Terminator::Return(Some(Operand::Val(ValueId(4)))),
+            },
+            BasicBlock {
+                id: BlockId(2),
+                instructions: vec![],
+                terminator: Terminator::Return(Some(Operand::Constant(Constant::Null))),
+            },
+        ],
+    }
+}
