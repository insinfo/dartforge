+        let summary = hir_summary(&module()).to_text();
+        assert!(Summary::from_string(&summary.replace("dartforge-poda\t6", "dartforge-poda\t5")).is_err());
+        assert!(Summary::from_string(&summary.replace("\"storage\":\"ref\"", "\"storage\":\"ptr\"")).is_err());
