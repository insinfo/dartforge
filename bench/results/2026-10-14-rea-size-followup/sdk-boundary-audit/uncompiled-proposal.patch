+//! Draft allocation-only export gate. Not wired into SDK publication or imports.
+//!
+//! The producer must bind this borrowed closure to the exact selected SDK cache
+//! key and emitted object hashes before serializing it. Consumers additionally
+//! reconcile every symbol, ABI and table against the actual linked app/SDK.
+use super::*;
+
+pub(super) struct AllocationExport<'a> {
+    pub(super) symbol: &'a str,
+    pub(super) parameters: Vec<Type>,
+    pub(super) classes: Classes,
+    /// Actual immutable bodies; serializers must preserve their artifact binding.
+    pub(super) closure: Vec<&'a Function>,
+}
+
+pub(super) fn candidates<'a>(modules: &[&'a Module], proof: &Provenance<'a>)
+    -> Vec<AllocationExport<'a>>
+{
+    if modules.iter().any(|m| !m.arc_fixed_ancestry || m.arc_memory
+        || m.arc_prepared || m.arc_aot_ports.is_some()) { return Vec::new(); }
+    let mut bodies = HashMap::new();
+    let mut duplicates = HashSet::new();
+    for f in modules.iter().flat_map(|m| &m.functions) {
+        if bodies.insert(f.symbol.as_str(), f).is_some() { duplicates.insert(f.symbol.as_str()); }
+    }
+    let mut exports = Vec::new();
+    for (&symbol, &body) in &bodies {
+        let Some(classes) = proof.returns.get(symbol) else { continue; };
+        if body.return_ty != Type::Ref || classes.iter().all(|cid| *cid == 1)
+            || proof.values_for(body).is_none() { continue; }
+        let mut visiting = HashSet::new();
+        let mut completed = HashSet::new();
+        let mut closure = Vec::new();
+        if audit(body, proof, &bodies, &duplicates, &mut visiting, &mut completed, &mut closure) {
+            exports.push(AllocationExport { symbol,
+                parameters: body.params.iter().map(|(_, _, ty)| *ty).collect(),
+                classes: classes.clone(), closure });
+        }
+    }
+    exports.sort_by_key(|export| export.symbol);
+    exports
+}
+
+fn audit<'a>(body: &'a Function, proof: &Provenance<'a>, bodies: &HashMap<&'a str, &'a Function>,
+    duplicates: &HashSet<&'a str>, visiting: &mut HashSet<&'a str>,
+    completed: &mut HashSet<&'a str>, closure: &mut Vec<&'a Function>) -> bool
+{
+    let symbol = body.symbol.as_str();
+    if duplicates.contains(symbol) || symbol.starts_with("dfc.")
+        || proof.values_for(body).is_none() { return false; }
+    if completed.contains(symbol) { return true; }
+    if !visiting.insert(symbol) { return false; }
+    let Ok(shape) = Shape::new(body) else { return false; };
+    // Audit all blocks, including dead ones: a new optimization pass must not
+    // resurrect excluded cache/address/global behavior behind this certificate.
+    for (_, instruction, _) in body.blocks.iter().flat_map(|block| &block.instructions) {
+        match instruction {
+            I::Const(Constant::Null | Constant::Int(_) | Constant::Bool(_) | Constant::Double(_))
+            | I::AllocObject { .. } | I::AllocList { .. }
+            | I::Phi { .. } | I::ICmp(..) | I::LNot(_) => {},
+            I::CallStatic { symbol, args, ret_ty } => {
+                let Some(&callee) = bodies.get(symbol.as_str()) else { return false; };
+                if callee.return_ty != *ret_ty || callee.params.len() != args.len()
+                    || !callee.params.iter().zip(args).all(|((_, _, ty), arg)|
+                        shape.operand_type(arg) == Some(*ty))
+                    || !audit(callee, proof, bodies, duplicates, visiting, completed, closure)
+                { return false; }
+            },
+            // No runtime calls in v1. AllocObject/AllocList have their emitter ABI
+            // checked by the existing provenance audit; constructors lowered via
+            // runtime calls remain unknown until a dedicated ABI export is added.
+            _ => return false,
+        }
+    }
+    // No function pointers or symbol/address operands may hide in Phi/allocations.
+    let mut forbidden_operand = false;
+    for block in &body.blocks {
+        for (_, instruction, _) in &block.instructions {
+            operands(instruction, &mut |operand| {
+                forbidden_operand |= matches!(operand,
+                    Operand::Constant(Constant::Function(_) | Constant::String(_) | Constant::StringWtf8(_)));
+            });
+        }
+        terminator_operands(&block.terminator, &mut |operand| {
+            forbidden_operand |= matches!(operand,
+                Operand::Constant(Constant::Function(_) | Constant::String(_) | Constant::StringWtf8(_)));
+        });
+    }
+    if forbidden_operand { return false; }
+    visiting.remove(symbol);
+    completed.insert(symbol);
+    closure.push(body);
+    true
+}
