[
  {
    "name": "jit",
    "command": [
      "cargo",
      "test",
      "--locked",
      "-p",
      "dartforge-jit",
      "--",
      "--include-ignored"
    ],
    "exit": 0
  },
  {
    "name": "clippy",
    "command": [
      "cargo",
      "clippy",
      "--locked",
      "--workspace",
      "--all-targets",
      "--",
      "-D",
      "warnings"
    ],
    "exit": 0
  },
  {
    "name": "doc",
    "command": [
      "cargo",
      "doc",
      "--locked",
      "--workspace",
      "--no-deps",
      "--document-private-items"
    ],
    "exit": 0
  }
]
