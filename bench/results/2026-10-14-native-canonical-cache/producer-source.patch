+        Resolved::Element(Element::Variable(v))
+        | Resolved::Member {
+            member: MemberRef::Variable(v),
+            ..
+        } => *v,
+        _ => return None,
+    };
+    let value = ctx.program.variable(variable);
+    let VariableRef::EnumConstant { unit, decl, index } = value.node else {
+        return None;
+    };
