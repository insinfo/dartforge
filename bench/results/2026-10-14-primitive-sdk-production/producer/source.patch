+            7 => {
+                let pair = value["tables"][0]["pairs"][0].clone();
+                value["tables"][0]["pairs"]
+                    .as_array_mut()
+                    .unwrap()
+                    .push(pair);
+            }
+            _ => value["unknown"] = serde_json::json!(true),
