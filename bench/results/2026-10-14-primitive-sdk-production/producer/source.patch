+        ["fresh", "factory"]
+    );
+    assert!(std::ptr::eq(factory.closure[0], &module.functions[0]));
+    let nullable = exports.iter().find(|e| e.symbol == "nullable").unwrap();
+    assert_eq!(nullable.classes, BTreeSet::from([1, 301]));
