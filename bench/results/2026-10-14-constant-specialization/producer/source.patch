+        return false;
+    }
+    if !matches!(&instructions[2].1, Instruction::StoreGlobal { symbol, val, ty: Type::Ref, root: Some(root) } if symbol == &premise.global && val == &object && *root == premise.root)
+    {
+        return false;
+    }
+    if !runtime(
