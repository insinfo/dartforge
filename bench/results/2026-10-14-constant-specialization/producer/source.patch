+                Operand::Constant(Constant::Int(i64::from(premise.class_id))),
+                Type::I64,
+            ),
+            (Operand::Constant(Constant::Int(2)), Type::I64),
+        ],
+        Type::Ref,
+    ) || instructions[1].2 != Type::Ref
