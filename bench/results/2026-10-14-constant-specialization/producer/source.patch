+        return false;
+    }
+    if !runtime(
+        &instructions[6].1,
+        "dartforge_object_set",
+        &[
+            (object.clone(), Type::Ref),
+            (Operand::Constant(Constant::Int(1)), Type::I64),
+            (Operand::Val(instructions[5].0), Type::I64),
+            (Operand::Constant(Constant::Int(1)), Type::I8),
+        ],
+        Type::Void,
+    ) {
+        return false;
+    }
