@@ -0,0 +1,297 @@
+//! Transport profitable ASCII data literals without changing their values.
+//!
+//! The private decoder reads only primitive string indices and owned dictionary
+//! slots. It does not call mutable String/Array prototype methods. Unicode,
+//! directives, literal keys, dynamic scopes and unprofitable inputs stay intact.
+
+use super::StringOccurrences;
+use oxc_ast::ast::{
+    BindingIdentifier, CallExpression, Expression, IdentifierReference, Statement, WithStatement,
+};
+use oxc_ast_visit::{Visit, walk};
+use std::collections::{BTreeMap, HashSet};
+
+const HEAD: &str = "(function () {\n";
+const MIN_LITERAL: usize = 128;
+const MAX_BYTES: usize = 2 * 1024 * 1024;
+const MAX_FRAGMENTS: usize = 2;
+
+#[derive(Default)]
+struct Names {
+    used: HashSet<String>,
+    dynamic_scope: bool,
+}
+
+impl<'a> Visit<'a> for Names {
+    fn visit_binding_identifier(&mut self, node: &BindingIdentifier<'a>) {
+        self.used.insert(node.name.to_string());
+    }
+    fn visit_identifier_reference(&mut self, node: &IdentifierReference<'a>) {
+        self.used.insert(node.name.to_string());
+    }
+    fn visit_call_expression(&mut self, node: &CallExpression<'a>) {
+        if matches!(&node.callee, Expression::Identifier(name) if name.name == "eval") {
+            self.dynamic_scope = true;
+        }
+        walk::walk_call_expression(self, node);
+    }
+    fn visit_with_statement(&mut self, _node: &WithStatement<'a>) {
+        self.dynamic_scope = true;
+    }
+}
+
+fn fresh(names: &mut HashSet<String>, prefix: &str) -> String {
+    for index in 0.. {
+        let name = format!("{prefix}{index}");
+        if names.insert(name.clone()) {
+            return name;
+        }
+    }
+    unreachable!()
+}
+
+fn word(byte: u8) -> bool {
+    byte.is_ascii_alphanumeric() || matches!(byte, b'_' | b'-' | b'%')
+}
+
+fn words(value: &str) -> impl Iterator<Item = &str> {
+    value
+        .split(|ch: char| !ch.is_ascii() || !word(ch as u8))
+        .filter(|part| (8..=64).contains(&part.len()))
+}
+
+fn encode(value: &str, dictionary: &[&str]) -> String {
+    let bytes = value.as_bytes();
+    let mut result = String::with_capacity(value.len());
+    let mut index = 0;
+    while index < bytes.len() {
+        if word(bytes[index]) {
+            let begin = index;
+            while index < bytes.len() && word(bytes[index]) {
+                index += 1;
+            }
+            let part = &value[begin..index];
+            if let Some(slot) = dictionary.iter().position(|candidate| *candidate == part) {
+                result.push('~');
+                result.push((b'0' + slot as u8) as char);
+            } else {
+                result.push_str(part);
+            }
+        } else {
+            let byte = bytes[index];
+            if byte == b'~' {
+                result.push('~');
+            }
+            result.push(byte as char);
+            index += 1;
+        }
+    }
+    result
+}
+
+pub(super) fn apply(source: &str) -> Result<String, String> {
+    if !source.starts_with(HEAD) {
+        return Ok(source.to_string());
+    }
+    let allocator = oxc_allocator::Allocator::default();
+    let parsed = oxc_parser::Parser::new(&allocator, source, oxc_span::SourceType::cjs()).parse();
+    if let Some(error) = parsed.diagnostics.first() {
+        return Err(format!(
+            "oxc could not parse literal transport input: {error}"
+        ));
+    }
+    let Some(Statement::ExpressionStatement(statement)) = parsed.program.body.first() else {
+        return Ok(source.to_string());
+    };
+    let Expression::CallExpression(call) = &statement.expression else {
+        return Ok(source.to_string());
+    };
+    let Expression::ParenthesizedExpression(parenthesized) = &call.callee else {
+        return Ok(source.to_string());
+    };
+    let Expression::FunctionExpression(function) = &parenthesized.expression else {
+        return Ok(source.to_string());
+    };
+    let Some(body) = &function.body else {
+        return Ok(source.to_string());
+    };
+    let insertion = body
+        .directives
+        .last()
+        .map_or(HEAD.len(), |directive| directive.span.end as usize);
+    let mut names = Names::default();
+    names.visit_program(&parsed.program);
+    if names.dynamic_scope {
+        return Ok(source.to_string());
+    }
+    let mut occurrences = StringOccurrences {
+        map: Default::default(),
+        sdk_end: super::marker_start(&parsed.program),
+        stack: Vec::new(),
+    };
+    occurrences.visit_program(&parsed.program);
+    let mut values = occurrences
+        .map
+        .into_iter()
+        .filter(|(value, _)| value.is_ascii() && value.len() >= MIN_LITERAL)
+        .collect::<Vec<_>>();
+    values.sort_by(|left, right| left.0.cmp(&right.0));
+    if values
+        .iter()
+        .try_fold(0usize, |total, (value, spans)| {
+            total.checked_add(value.len().checked_mul(spans.len())?)
+        })
+        .is_none_or(|bytes| bytes > MAX_BYTES)
+    {
+        return Ok(source.to_string());
+    }
+    let mut counts = BTreeMap::<&str, usize>::new();
+    for (value, spans) in &values {
+        for fragment in words(value) {
+            *counts.entry(fragment).or_default() += spans.len();
+        }
+    }
+    let mut candidates = counts
+        .into_iter()
+        .filter_map(|(fragment, count)| {
+            let cost = dartforge_emit_js::js::string_literal(fragment).len() + 1;
+            let saved = (fragment.len() - 2) * count;
+            (count >= 2 && saved > cost).then_some((saved.saturating_sub(cost), fragment))
+        })
+        .collect::<Vec<_>>();
+    candidates.sort_by(|left, right| right.0.cmp(&left.0).then_with(|| left.1.cmp(right.1)));
+    let dictionary = candidates
+        .iter()
+        .take(MAX_FRAGMENTS)
+        .map(|(_, fragment)| *fragment)
+        .collect::<Vec<_>>();
+    if dictionary.is_empty() {
+        return Ok(source.to_string());
+    }
+    let decoder = fresh(&mut names.used, "t$L");
+    let table = fresh(&mut names.used, "t$SF");
+    let helper = format!(
+        "var {table} = [{}];\nfunction {decoder}(s) {{ let r = ''; for (let i = 0; i < s.length; i++) {{ let c = s[i]; if (c === '~') {{ let k = s[++i]; r += k === '~' ? '~' : {table}[k]; }} else r += c; }} return r; }}\n",
+        dictionary
+            .iter()
+            .map(|fragment| dartforge_emit_js::js::string_literal(fragment))
+            .collect::<Vec<_>>()
+            .join(",")
+    );
+    let mut edits = Vec::new();
+    let mut savings = 0usize;
+    for (value, spans) in &values {
+        let encoded = encode(value, &dictionary);
+        let replacement = format!(
+            "{decoder}({})",
+            dartforge_emit_js::js::string_literal(&encoded)
+        );
+        for &(begin, end) in spans {
+            let size = (end - begin) as usize;
+            if replacement.len() < size {
+                savings += size - replacement.len();
+                edits.push((begin as usize, end as usize, replacement.clone()));
+            }
+        }
+    }
+    // Pay the complete unminified helper/table cost plus a conservative margin.
+    if savings <= helper.len() + 1024 {
+        return Ok(source.to_string());
+    }
+    edits.sort_by_key(|edit| edit.0);
+    let mut result = String::with_capacity(source.len());
+    result.push_str(&source[..insertion]);
+    result.push('\n');
+    result.push_str(&helper);
+    let mut position = insertion;
+    for (begin, end, replacement) in edits {
+        if begin < position {
+            return Ok(source.to_string());
+        }
+        result.push_str(&source[position..begin]);
+        result.push_str(&replacement);
+        position = end;
+    }
+    result.push_str(&source[position..]);
+    Ok(result)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn large() -> String {
+        "shared-fragment-alpha shared-fragment-beta ~0 ~~ ".repeat(100)
+    }
+
+    #[test]
+    fn small_unicode_and_dynamic_scope_inputs_remain_unchanged() {
+        for source in [
+            format!("{HEAD}console.log('small');\n}})();\n"),
+            format!(
+                "{HEAD}console.log({});\n}})();\n",
+                dartforge_emit_js::js::string_literal(&(large() + "é"))
+            ),
+            format!(
+                "{HEAD}console.log({}); eval('1');\n}})();\n",
+                dartforge_emit_js::js::string_literal(&large())
+            ),
+            format!(
+                "{HEAD}with (o) {{ console.log({}); }}\n}})();\n",
+                dartforge_emit_js::js::string_literal(&large())
+            ),
+        ] {
+            assert_eq!(apply(&source).unwrap(), source);
+        }
+    }
+
+    #[test]
+    fn marker_roundtrip_and_fresh_names_are_deterministic() {
+        let source = format!(
+            "{HEAD}let t$L0 = 1, t$SF0 = 2; console.log({}, t$L0, t$SF0);\n}})();\n",
+            dartforge_emit_js::js::string_literal(&large())
+        );
+        let output = apply(&source).unwrap();
+        assert!(output.len() + 1024 < source.len());
+        assert!(output.contains("function t$L1(s)"));
+        assert!(output.contains("var t$SF1 ="));
+        assert_eq!(output, apply(&source).unwrap());
+    }
+
+    #[test]
+    #[ignore = "requires Node"]
+    fn decoder_ignores_mutated_prototype_methods_and_preserves_keys() {
+        use std::io::Write;
+        use std::process::{Command, Stdio};
+        let value = large();
+        let quoted = dartforge_emit_js::js::string_literal(&value);
+        let source = format!(
+            "{HEAD}'use strict'; const object = {{{quoted}: 7}}; const saved = [String.prototype.split, String.prototype.slice, String.prototype.replace, Array.prototype.join, Array.prototype[Symbol.iterator]]; String.prototype.split = String.prototype.slice = String.prototype.replace = Array.prototype.join = Array.prototype[Symbol.iterator] = () => {{ throw Error('prototype invoked'); }}; const output = {quoted}; String.prototype.split=saved[0];String.prototype.slice=saved[1];String.prototype.replace=saved[2];Array.prototype.join=saved[3];Array.prototype[Symbol.iterator]=saved[4]; if(output !== {quoted} || object[output] !== 7) throw Error('transport mismatch'); console.log('exact');\n}})();\n"
+        );
+        let changed = apply(&source).unwrap();
+        assert!(
+            changed.contains(&format!("{{{quoted}: 7}}")),
+            "literal key changed"
+        );
+        assert!(changed.starts_with("(function () {\n'use strict';\n"));
+        let mut process = Command::new("node")
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::piped())
+            .spawn()
+            .unwrap();
+        process
+            .stdin
+            .take()
+            .unwrap()
+            .write_all(changed.as_bytes())
+            .unwrap();
+        let result = process.wait_with_output().unwrap();
+        assert!(
+            result.status.success(),
+            "{}",
+            String::from_utf8_lossy(&result.stderr)
+        );
+        assert_eq!(String::from_utf8(result.stdout).unwrap(), "exact\n");
+    }
+}
