@@ -0,0 +1,95 @@
+//! Encoded long data strings preserve ordinary Dart values and effects.
+
+use std::io::Write;
+use std::path::Path;
+use std::process::{Command, Stdio};
+
+fn node_output(js: &str) -> String {
+    let mut node = Command::new("node")
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .expect("Node");
+    node.stdin
+        .take()
+        .unwrap()
+        .write_all(format!("globalThis.self=globalThis;\n{js}").as_bytes())
+        .unwrap();
+    let result = node.wait_with_output().unwrap();
+    assert!(
+        result.status.success(),
+        "{}",
+        String::from_utf8_lossy(&result.stderr)
+    );
+    assert!(
+        result.stderr.is_empty(),
+        "{}",
+        String::from_utf8_lossy(&result.stderr)
+    );
+    String::from_utf8(result.stdout)
+        .unwrap()
+        .replace("\r\n", "\n")
+}
+
+#[test]
+#[ignore = "requires Dart 3.6.2 and Node on PATH"]
+fn long_literals_keys_unicode_and_effect_order_match_vm_and_o2() {
+    let source = Path::new(env!("CARGO_MANIFEST_DIR"))
+        .join("../emit_js/tests/programs/literal_fragments.dart");
+    let oracle = Command::new("dart")
+        .arg("run")
+        .arg(&source)
+        .output()
+        .expect("Dart");
+    assert!(
+        oracle.status.success(),
+        "{}",
+        String::from_utf8_lossy(&oracle.stderr)
+    );
+    let expected = String::from_utf8(oracle.stdout)
+        .unwrap()
+        .replace("\r\n", "\n");
+    let directory = std::env::temp_dir().join(format!(
+        "dartforge-literals-{}-{}",
+        std::process::id(),
+        std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .unwrap()
+            .as_nanos()
+    ));
+    std::fs::create_dir(&directory).unwrap();
+    let official = directory.join("official-O2.js");
+    let result = Command::new("dart")
+        .args(["compile", "js", "-O2"])
+        .arg(&source)
+        .arg("-o")
+        .arg(&official)
+        .output()
+        .expect("dart2js");
+    assert!(
+        result.status.success(),
+        "{}",
+        String::from_utf8_lossy(&result.stderr)
+    );
+    assert_eq!(
+        node_output(&std::fs::read_to_string(&official).unwrap()),
+        expected
+    );
+    for minify in [false, true] {
+        let options = dartforge_emit_js_production::Options {
+            minify,
+            ..Default::default()
+        };
+        let production = dartforge_emit_js_production::compile_own_sdk(
+            &source,
+            None,
+            None,
+            options,
+            &Default::default(),
+        )
+        .expect("production compilation");
+        assert_eq!(node_output(&production.js), expected, "minify={minify}");
+    }
+    std::fs::remove_dir_all(directory).unwrap();
+}
