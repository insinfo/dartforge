{
  "comment:0": "SDK overlay for the DartForge native backend (docs/NATIVO-PLANO.md \u00a77, P5a).",
  "comment:1": "The target starts from a section of the SDK's libraries.json (base) and swaps whole files: the key is the path relative to the SDK's lib/, the value the file of this folder that replaces it.",
  "comment:2": "The logical path is still the SDK's: a 'part' of a replaced file resolves next to the original, and may itself be replaced.",
  "comment:3": "Only what depends on the VM's internal machinery is ours: _SuspendState (async), Timer and microtasks tied to dart:isolate/dart:io, and the weak-GC Finalizer.",
  "dartforge_native": {
    "base": "vm",
    "replaces": {
      "_internal/vm/lib/async_patch.dart": "async/async_patch.dart",
      "_internal/vm/lib/schedule_microtask_patch.dart": "async/schedule_microtask_patch.dart",
      "_internal/vm/lib/timer_patch.dart": "async/timer_patch.dart",
      "_internal/vm/lib/finalizer_patch.dart": "core/finalizer_patch.dart",
      "_internal/vm/lib/print_patch.dart": "internal/print_patch.dart",
      "_internal/vm_shared/lib/string_buffer_patch.dart": "core/string_buffer_patch.dart",
      "_internal/vm_shared/lib/compact_hash.dart": "collection/compact_hash.dart",
      "_internal/vm/lib/identical_patch.dart": "core/identical_patch.dart",
      "_internal/vm/lib/growable_array.dart": "core/growable_array.dart",
      "_internal/vm/lib/array.dart": "core/array.dart",
      "_internal/vm/lib/string_patch.dart": "core/string_patch.dart",
      "_internal/vm/lib/double.dart": "core/double.dart",
      "_internal/vm/lib/integers.dart": "core/integers.dart",
      "_internal/vm/lib/convert_patch.dart": "convert/convert_patch.dart",
      "convert/json.dart": "convert/json.dart",
      "_internal/vm/lib/function.dart": "core/function.dart",
      "_internal/vm/lib/profiler.dart": "developer/profiler.dart",
      "_internal/vm/lib/regexp_patch.dart": "core/regexp_patch.dart",
      "_internal/vm/lib/isolate_patch.dart": "isolate/isolate_patch.dart",
      "html/dartium/nativewrappers.dart": "nativewrappers/nativewrappers.dart",
      "_internal/vm/bin/common_patch.dart": "io/common_patch.dart",
      "_internal/vm/lib/ffi_patch.dart": "ffi/ffi_patch.dart",
      "_internal/vm/lib/ffi_allocation_patch.dart": "ffi/ffi_allocation_patch.dart",
      "_internal/vm/lib/ffi_dynamic_library_patch.dart": "ffi/ffi_dynamic_library_patch.dart",
      "_internal/vm/lib/ffi_native_finalizer_patch.dart": "ffi/ffi_native_finalizer_patch.dart",
      "_internal/vm/bin/io_service_patch.dart": "io/io_service_patch.dart",
      "_internal/vm/bin/secure_socket_patch.dart": "io/secure_socket_patch.dart",
      "internal/sort.dart": "internal/sort.dart",
      "collection/list.dart": "collection/list.dart",
      "_internal/vm/lib/mirrors_patch.dart": "mirrors/mirrors_patch.dart"
    },
    "libraries": {
      "_http": {
        "uri": "_http/http.dart",
        "patches": [
          "overlay:http/http_patch.dart"
        ]
      }
    }
  },
  "comment:4": "dartforge_wasm: the WebAssembly target (wasm32-linear, docs/PLANO-WASM-MVP.md \u00a71). The runtime implements the VM's natives, so the base is vm with the same swaps; the library set and flags are dart2wasm's: dart:io and dart:isolate take the SDK's own pure-Dart wasm patches (importable, UnsupportedError on use), dart.library.ffi is false, the libraries dart2wasm does not have are removed, and the JavaScript interop (dart:js_interop, js_interop_unsafe, js_util and their internal libraries) is added over the handles of native_sdk/wasm/js_helper.dart (\"new\": a library the base does not have; \"overlay:\": a file of this folder).",
  "dartforge_wasm": {
    "base": "vm",
    "libraries": {
      "io": {
        "uri": "io/io.dart",
        "patches": [
          "_internal/wasm/lib/io_patch.dart"
        ],
        "supported": false
      },
      "isolate": {
        "uri": "isolate/isolate.dart",
        "patches": [
          "_internal/wasm/lib/isolate_patch.dart"
        ]
      },
      "ffi": {
        "uri": "ffi/ffi.dart",
        "patches": [
          "_internal/vm/lib/ffi_patch.dart",
          "_internal/vm/lib/ffi_allocation_patch.dart",
          "_internal/vm/lib/ffi_dynamic_library_patch.dart",
          "_internal/vm/lib/ffi_native_finalizer_patch.dart",
          "_internal/vm/lib/ffi_native_type_patch.dart",
          "_internal/vm/lib/ffi_struct_patch.dart"
        ],
        "supported": false
      },
      "_js_helper": {
        "uri": "overlay:wasm/js_helper.dart",
        "new": true
      },
      "_js_types": {
        "uri": "overlay:wasm/js_types.dart",
        "new": true
      },
      "_js_annotations": {
        "uri": "js/_js_annotations.dart",
        "new": true
      },
      "js_interop": {
        "uri": "js_interop/js_interop.dart",
        "patches": [
          "overlay:wasm/js_interop_patch.dart"
        ],
        "new": true
      },
      "js_interop_unsafe": {
        "uri": "js_interop_unsafe/js_interop_unsafe.dart",
        "patches": [
          "overlay:wasm/js_interop_unsafe_patch.dart"
        ],
        "new": true
      },
      "js_util": {
        "uri": "js_util/js_util.dart",
        "patches": [
          "overlay:wasm/js_util_patch.dart"
        ],
        "new": true
      }
    },
    "remove": [
      "_builtin",
      "_vmservice",
      "vmservice_io",
      "cli",
      "concurrent",
      "mirrors"
    ],
    "user_import_errors": {
      "ffi": "'dart:ffi' can't be imported when compiling to Wasm.",
      "js_util": "JS interop library 'dart:js_util' can't be imported when compiling to Wasm. Try using 'dart:js_interop' or 'dart:js_interop_unsafe' instead."
    },
    "replaces": {
      "_internal/vm/lib/async_patch.dart": "async/async_patch.dart",
      "_internal/vm/lib/schedule_microtask_patch.dart": "async/schedule_microtask_patch.dart",
      "_internal/vm/lib/timer_patch.dart": "async/timer_patch.dart",
      "_internal/vm/lib/finalizer_patch.dart": "core/finalizer_patch.dart",
      "_internal/vm/lib/print_patch.dart": "internal/print_patch.dart",
      "_internal/vm_shared/lib/string_buffer_patch.dart": "core/string_buffer_patch.dart",
      "_internal/vm_shared/lib/compact_hash.dart": "collection/compact_hash.dart",
      "_internal/vm/lib/identical_patch.dart": "core/identical_patch.dart",
      "_internal/vm/lib/growable_array.dart": "core/growable_array.dart",
      "_internal/vm/lib/array.dart": "core/array.dart",
      "_internal/vm/lib/string_patch.dart": "core/string_patch.dart",
      "_internal/vm/lib/double.dart": "core/double.dart",
      "_internal/vm/lib/integers.dart": "core/integers.dart",
      "_internal/vm/lib/convert_patch.dart": "convert/convert_patch.dart",
      "convert/json.dart": "convert/json.dart",
      "_internal/vm/lib/function.dart": "core/function.dart",
      "_internal/vm/lib/profiler.dart": "developer/profiler.dart",
      "_internal/vm/lib/regexp_patch.dart": "core/regexp_patch.dart",
      "html/dartium/nativewrappers.dart": "nativewrappers/nativewrappers.dart",
      "_internal/vm/lib/ffi_patch.dart": "ffi/ffi_patch.dart",
      "_internal/vm/lib/ffi_allocation_patch.dart": "ffi/ffi_allocation_patch.dart",
      "_internal/vm/lib/ffi_dynamic_library_patch.dart": "ffi/ffi_dynamic_library_patch.dart",
      "_internal/vm/lib/ffi_native_finalizer_patch.dart": "ffi/ffi_native_finalizer_patch.dart",
      "internal/sort.dart": "internal/sort.dart",
      "collection/list.dart": "collection/list.dart",
      "_internal/vm/lib/uri_patch.dart": "wasm/uri_patch.dart"
    }
  }
}
